{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "matcher/result.schema.json",
  "title": "Matcher result",
  "description": "What match(profile, slice, opts) returns (matcher/README.md). Owned by the matcher lane, not a frozen contract. Numbers are rounded half up: coverage, values, norms and bridge gains to 4 decimals, score to 6, pay_change_pct to 2. Matcher 1.2.0 (S2) added fields and never renamed one: credentials; per road level.range, level.basis, bridge_detail and pay_change_pct (README, 'S2 additions').",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "release",
    "from",
    "person",
    "weights",
    "stubs",
    "credentials",
    "roads"
  ],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "release": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "from": {
      "type": "string",
      "pattern": "^occ:"
    },
    "person": {
      "$ref": "#/$defs/level"
    },
    "weights": {
      "$ref": "#/$defs/weights"
    },
    "stubs": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40
      }
    },
    "credentials": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/held_credential"
      }
    },
    "roads": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "$ref": "#/$defs/road"
      }
    }
  },
  "$defs": {
    "level": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "years_total",
        "years_level",
        "lead_bonus",
        "title_override"
      ],
      "properties": {
        "level": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 6
        },
        "years_total": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "years_level": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 6
        },
        "lead_bonus": {
          "type": "integer",
          "enum": [
            0,
            1
          ]
        },
        "title_override": {
          "type": "null"
        }
      }
    },
    "weights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pay",
        "ai_safe",
        "short",
        "demand",
        "enjoy"
      ],
      "properties": {
        "pay": {
          "type": "number",
          "minimum": 0
        },
        "ai_safe": {
          "type": "number",
          "minimum": 0
        },
        "short": {
          "type": "number",
          "minimum": 0
        },
        "demand": {
          "type": "number",
          "minimum": 0
        },
        "enjoy": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "norm",
        "weight",
        "status"
      ],
      "properties": {
        "value": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "norm": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "weight": {
          "type": "number",
          "minimum": 0
        },
        "status": {
          "type": "string",
          "enum": [
            "measured",
            "unknown",
            "not_yet_measured"
          ]
        }
      }
    },
    "gap_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "w",
        "cover",
        "ai",
        "people_do",
        "priority"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(skl|tec):"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "w": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "cover": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "ai": {
          "type": "string",
          "enum": [
            "ai_does_much",
            "mixed",
            "people_do",
            "unknown"
          ]
        },
        "people_do": {
          "type": "boolean"
        },
        "priority": {
          "type": "number",
          "minimum": 0,
          "maximum": 1.5
        }
      }
    },
    "road": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "via",
        "new_role",
        "reach",
        "coverage",
        "score",
        "components",
        "gap",
        "kind",
        "level",
        "flags",
        "bridges",
        "bridge_detail",
        "pay_change_pct"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^occ:"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "via": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "string",
            "enum": [
              "close_to",
              "two_step",
              "same_cluster",
              "entry_from"
            ]
          }
        },
        "new_role": {
          "type": "boolean"
        },
        "reach": {
          "type": "string",
          "enum": [
            "adjacent",
            "stretch",
            "leap"
          ]
        },
        "coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "components": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pay",
            "ai_safe",
            "short",
            "demand",
            "enjoy"
          ],
          "properties": {
            "pay": {
              "$ref": "#/$defs/component"
            },
            "ai_safe": {
              "$ref": "#/$defs/component"
            },
            "short": {
              "$ref": "#/$defs/component"
            },
            "demand": {
              "$ref": "#/$defs/component"
            },
            "enjoy": {
              "$ref": "#/$defs/component"
            }
          }
        },
        "gap": {
          "type": "array",
          "maxItems": 40,
          "items": {
            "$ref": "#/$defs/gap_item"
          }
        },
        "kind": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "up",
            "across",
            "diagonal",
            "reset",
            "fork",
            null
          ]
        },
        "level": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "target",
            "fit",
            "range",
            "basis"
          ],
          "properties": {
            "target": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 6
            },
            "fit": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "below",
                "in",
                "above",
                null
              ]
            },
            "range": {
              "type": [
                "array",
                "null"
              ],
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 6
              }
            },
            "basis": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "typical_level",
                "job_zone",
                null
              ]
            }
          }
        },
        "flags": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "string",
            "enum": [
              "outside_time",
              "below_pay_floor",
              "needs_relocation"
            ]
          }
        },
        "bridges": {
          "type": [
            "array",
            "null"
          ],
          "maxItems": 3,
          "items": {
            "type": "string",
            "pattern": "^cred:"
          }
        },
        "bridge_detail": {
          "$ref": "#/$defs/bridge_detail"
        },
        "pay_change_pct": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "held_credential": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "renew"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^cred:"
        },
        "status": {
          "type": "string",
          "enum": [
            "valid",
            "expired"
          ]
        },
        "renew": {
          "type": "boolean"
        }
      }
    },
    "bridge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "issuer",
        "covers",
        "gain",
        "cost_inr",
        "hours",
        "validity_years",
        "url",
        "renew"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^cred:"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "issuer": {
          "type": [
            "string",
            "null"
          ]
        },
        "covers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 40,
          "items": {
            "type": "string",
            "pattern": "^(skl|tec):"
          }
        },
        "gain": {
          "type": "number",
          "minimum": 0
        },
        "cost_inr": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "hours": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "validity_years": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "renew": {
          "type": "boolean"
        }
      }
    },
    "bridge_detail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "items",
        "skills"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "reviewed",
            "no_reviewed_course"
          ]
        },
        "items": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/bridge"
          }
        },
        "skills": {
          "type": "array",
          "maxItems": 40,
          "items": {
            "type": "string",
            "pattern": "^(skl|tec):"
          }
        }
      }
    }
  }
}

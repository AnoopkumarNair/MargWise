{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/api/me_export.response.schema.json",
  "title": "me_export response",
  "description": "Everything in the data inventory for this tester (ADR-14), table by table, as columns and rows. JSON documents such as the profile appear as text.",
  "type": "object",
  "additionalProperties": false,
  "required": ["ok", "generated_at", "tables"],
  "properties": {
    "ok": {
      "enum": [true]
    },
    "generated_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000000000
    },
    "tables": {
      "type": "array",
      "minItems": 0,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["table", "columns", "rows"],
        "properties": {
          "table": {
            "type": "string",
            "pattern": "^[a-z_][a-z0-9_]*$"
          },
          "columns": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          "rows": {
            "type": "array",
            "minItems": 0,
            "maxItems": 100000,
            "items": {
              "type": "array",
              "minItems": 0,
              "maxItems": 64,
              "items": {
                "type": ["string", "number", "boolean", "null"]
              }
            }
          }
        }
      }
    }
  }
}

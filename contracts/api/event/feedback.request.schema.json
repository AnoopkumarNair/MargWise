{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/api/event/feedback.request.schema.json",
  "title": "event feedback request",
  "description": "POST /api/v1/event with type \"feedback\" (SPEC 9, ADR-08, deviations D6). Strict: type must be \"feedback\" and data allows only the feedback fields, so a body that mixes fields of two types fails. The handler picks this schema by the body's type with schemaForType(type) from contracts/event_schemas.js; an unknown type is bad_request. Generated from events.schema.json by contracts/sync.mjs: do not edit by hand.",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "eid", "data"],
  "properties": {
    "type": {
      "type": "string",
      "enum": ["feedback"]
    },
    "eid": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{8,40}$"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["about"],
      "properties": {
        "about": {
          "type": "string",
          "enum": ["intake", "roads", "road", "job_today", "general"]
        },
        "from": {
          "type": "string",
          "maxLength": 80,
          "pattern": "^occ:([0-9]{2}-[0-9]{4}\\.[0-9]{2}|(ai|in)-[a-z0-9]+(-[a-z0-9]+)*)$"
        },
        "to": {
          "type": "string",
          "maxLength": 80,
          "pattern": "^occ:([0-9]{2}-[0-9]{4}\\.[0-9]{2}|(ai|in)-[a-z0-9]+(-[a-z0-9]+)*)$"
        },
        "worth_exploring": {
          "type": "boolean"
        },
        "kind_agree": {
          "type": "boolean"
        },
        "rating": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "text": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1500,
          "pattern": "^[^@]*$"
        },
        "job_release": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "matcher_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/api/event/road_added.request.schema.json",
  "title": "event road_added request",
  "description": "POST /api/v1/event with type \"road_added\" (SPEC 9, ADR-08, deviations D6). Strict: type must be \"road_added\" and data allows only the road_added fields, so a body that mixes fields of two types fails. The handler picks this schema by the body's type with schemaForType(type) from contracts/event_schemas.js; an unknown type is bad_request. Generated from events.schema.json by contracts/sync.mjs: do not edit by hand.",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "eid", "data"],
  "properties": {
    "type": {
      "type": "string",
      "enum": ["road_added"]
    },
    "eid": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{8,40}$"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "job_release", "matcher_version"],
      "properties": {
        "from": {
          "type": "string",
          "maxLength": 80,
          "pattern": "^occ:([0-9]{2}-[0-9]{4}\\.[0-9]{2}|(ai|in)-[a-z0-9]+(-[a-z0-9]+)*)$"
        },
        "to": {
          "type": "string",
          "maxLength": 80,
          "pattern": "^occ:([0-9]{2}-[0-9]{4}\\.[0-9]{2}|(ai|in)-[a-z0-9]+(-[a-z0-9]+)*)$"
        },
        "rank": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "kind": {
          "type": "string",
          "enum": ["up", "across", "diagonal", "reset", "fork"]
        },
        "reach": {
          "type": "string",
          "enum": ["adjacent", "stretch", "leap"]
        },
        "flags": {
          "type": "array",
          "minItems": 0,
          "maxItems": 3,
          "items": {
            "type": "string",
            "enum": ["outside_time", "below_pay_floor", "needs_relocation"]
          }
        },
        "job_release": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "matcher_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    }
  }
}

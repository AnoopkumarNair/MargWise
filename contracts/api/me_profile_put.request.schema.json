{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/api/me_profile_put.request.schema.json",
  "title": "me_profile_put request",
  "description": "PUT /api/v1/me/profile (SPEC 9, ADR-06). rev is the revision the edit started from (0 for a first save). The server checks ids against the release id list and writes WHERE rev = ?; a mismatch is a 409 conflict with the current document. $defs.profile is a copy of profile.schema.json, kept equal by contracts/sync.mjs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["rev", "data"],
  "properties": {
    "rev": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000
    },
    "data": {
      "$ref": "#/$defs/profile"
    }
  },
  "$defs": {
    "profile": {
      "description": "The adult profile (SPEC 6), stored in D1 as one JSON document (ADR-06). Ids and bands only: no free text, no names, and no demographic or commercial field (ADR-16). The 32 KB size cap is checked by the server, not here. The edit counter rev is not part of this document: it lives in the profiles table and in the API wrapper ({rev, data}), and the server sets it (ADR-06, deviations D4).",
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "roles", "skills"],
      "properties": {
        "v": {
          "type": "integer",
          "enum": [1]
        },
        "roles": {
          "type": "array",
          "minItems": 0,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["occ", "level", "industry", "years", "current"],
            "properties": {
              "occ": {
                "type": "string",
                "maxLength": 80,
                "pattern": "^occ:([0-9]{2}-[0-9]{4}\\.[0-9]{2}|(ai|in)-[a-z0-9]+(-[a-z0-9]+)*)$"
              },
              "level": {
                "type": "integer",
                "enum": [1, 2, 3, 4, 5, 6]
              },
              "industry": {
                "type": "string",
                "enum": ["it", "bpm", "bfsi", "other"]
              },
              "years": {
                "type": "string",
                "enum": ["0-2", "2-5", "5-8", "8-12", "12-18", "18+"]
              },
              "current": {
                "type": "boolean"
              }
            }
          }
        },
        "skills": {
          "type": "array",
          "minItems": 0,
          "maxItems": 300,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "strength"],
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 80,
                "pattern": "^(skl|tec):[A-Za-z0-9]+([._-][A-Za-z0-9]+)*$"
              },
              "strength": {
                "type": "string",
                "enum": ["strong", "used", "rusty"]
              },
              "last": {
                "type": "integer",
                "minimum": 1950,
                "maximum": 2100
              }
            }
          }
        },
        "creds": {
          "type": "array",
          "minItems": 0,
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id"],
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 80,
                "pattern": "^cred:[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "year": {
                "type": "integer",
                "minimum": 1950,
                "maximum": 2100
              },
              "expires": {
                "type": ["integer", "null"],
                "minimum": 1950,
                "maximum": 2100
              }
            }
          }
        },
        "lead": {
          "type": "object",
          "additionalProperties": false,
          "required": ["people", "budget", "expert"],
          "properties": {
            "people": {
              "type": "string",
              "enum": ["0", "1-5", "6-20", "21+"]
            },
            "budget": {
              "type": "boolean"
            },
            "expert": {
              "type": "boolean"
            }
          }
        },
        "constraints": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {
            "hours_month": {
              "type": "string",
              "enum": ["0-5", "5-10", "10-20", "20-40", "40+"]
            },
            "course_budget": {
              "type": "string",
              "enum": ["free", "up-to-10k", "10k-50k", "50k-2L", "2L+"]
            },
            "city": {
              "type": "string",
              "enum": ["city:blr", "city:hyd", "city:pnq", "city:maa", "city:ncr", "city:bom", "city:ccu", "city:amd", "city:cjb", "city:cok", "city:jai", "city:idr", "city:bbi", "city:vtz", "city:trv", "city:ixc", "city:nag", "city:mys", "city:other"]
            },
            "open_to": {
              "type": "array",
              "minItems": 0,
              "maxItems": 22,
              "items": {
                "type": "string",
                "enum": ["city:blr", "city:hyd", "city:pnq", "city:maa", "city:ncr", "city:bom", "city:ccu", "city:amd", "city:cjb", "city:cok", "city:jai", "city:idr", "city:bbi", "city:vtz", "city:trv", "city:ixc", "city:nag", "city:mys", "city:other", "open:india", "open:remote", "open:abroad"]
              }
            },
            "pay_floor_pct": {
              "type": "integer",
              "enum": [-30, -20, -10, 0, 10, 20]
            },
            "mode": {
              "type": "string",
              "enum": ["office", "hybrid", "remote", "any"]
            }
          }
        },
        "priorities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pay", "ai_safe", "short_move", "demand", "enjoy"],
          "properties": {
            "pay": {
              "type": "integer",
              "enum": [0, 1, 2, 3, 4, 5]
            },
            "ai_safe": {
              "type": "integer",
              "enum": [0, 1, 2, 3, 4, 5]
            },
            "short_move": {
              "type": "integer",
              "enum": [0, 1, 2, 3, 4, 5]
            },
            "demand": {
              "type": "integer",
              "enum": [0, 1, 2, 3, 4, 5]
            },
            "enjoy": {
              "type": "integer",
              "enum": [0, 1, 2, 3, 4, 5]
            }
          }
        },
        "job_release": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "matcher_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    }
  }
}

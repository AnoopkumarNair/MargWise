{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/api/ai_read.response.schema.json",
  "title": "ai_read response",
  "description": "The checked AI read: result follows extract.schema.json with unknown ids already removed; dropped counts them. prompt_v is the prompt version (ADR-17). $defs.extract is a copy of extract.schema.json, kept equal by contracts/sync.mjs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["ok", "result", "dropped", "prompt_v"],
  "properties": {
    "ok": {
      "enum": [true]
    },
    "result": {
      "$ref": "#/$defs/extract"
    },
    "dropped": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "prompt_v": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    }
  },
  "$defs": {
    "extract": {
      "description": "What the AI read returns (SPEC 9, BUILD_PLAN T6.4): roles (title text from the redacted resume, an employer placeholder, start and end), skills as graph ids with the source line, and credentials. The server rejects any output that fails this schema or contains an email or phone pattern, and drops unknown ids. role is the index of the role the skill was found under.",
      "type": "object",
      "additionalProperties": false,
      "required": ["roles", "skills", "creds"],
      "properties": {
        "roles": {
          "type": "array",
          "minItems": 0,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title"],
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "occ": {
                "type": "string",
                "maxLength": 80,
                "pattern": "^occ:([0-9]{2}-[0-9]{4}\\.[0-9]{2}|(ai|in)-[a-z0-9]+(-[a-z0-9]+)*)$"
              },
              "employer": {
                "type": ["string", "null"],
                "pattern": "^\\[EMPLOYER_[0-9]{1,3}\\]$"
              },
              "start": {
                "type": "string",
                "pattern": "^([0-9]{4}(-[0-9]{2})?|present)$"
              },
              "end": {
                "type": "string",
                "pattern": "^([0-9]{4}(-[0-9]{2})?|present)$"
              }
            }
          }
        },
        "skills": {
          "type": "array",
          "minItems": 0,
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "line"],
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 80,
                "pattern": "^(skl|tec):[A-Za-z0-9]+([._-][A-Za-z0-9]+)*$"
              },
              "line": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "role": {
                "type": "integer",
                "minimum": 0,
                "maximum": 19
              }
            }
          }
        },
        "creds": {
          "type": "array",
          "minItems": 0,
          "maxItems": 30,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "line"],
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 80,
                "pattern": "^cred:[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "line": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "year": {
                "type": "integer",
                "minimum": 1950,
                "maximum": 2100
              }
            }
          }
        }
      }
    }
  }
}

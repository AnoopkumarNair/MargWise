{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/events.schema.json",
  "title": "Adult event",
  "description": "One adult event (SPEC 9, ADR-08). Two steps: validate the whole event against this schema, then validate data against #/$defs/<type> (validate(schema, event.data, \"#/$defs/\" + event.type)). Ids, numbers, enums and flags only, plus feedback text capped at 1,500 characters. Result events carry job_release and matcher_version (invariant 7).",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "eid", "data"],
  "properties": {
    "type": {
      "type": "string",
      "enum": ["intake", "profile_saved", "roads_viewed", "road_opened", "road_added", "feedback"]
    },
    "eid": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{8,40}$"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "enum": ["upload", "paste", "title"]
        },
        "mode": {
          "type": "string",
          "enum": ["most_accurate", "on_device", "none"]
        },
        "n_roles": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50
        },
        "n_found": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "n_confirmed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400000
        },
        "fallback": {
          "type": "boolean"
        },
        "prompt_v": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "rev": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000
        },
        "n_skills": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "n_creds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "job_release": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "matcher_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "from": {
          "type": "string",
          "maxLength": 80,
          "pattern": "^occ:([0-9]{2}-[0-9]{4}\\.[0-9]{2}|(ai|in)-[a-z0-9]+(-[a-z0-9]+)*)$"
        },
        "roads": {
          "type": "array",
          "minItems": 0,
          "maxItems": 30,
          "items": {
            "type": "string",
            "maxLength": 80,
            "pattern": "^occ:([0-9]{2}-[0-9]{4}\\.[0-9]{2}|(ai|in)-[a-z0-9]+(-[a-z0-9]+)*)$"
          }
        },
        "n_leaps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "leaps_shown": {
          "type": "boolean"
        },
        "to": {
          "type": "string",
          "maxLength": 80,
          "pattern": "^occ:([0-9]{2}-[0-9]{4}\\.[0-9]{2}|(ai|in)-[a-z0-9]+(-[a-z0-9]+)*)$"
        },
        "rank": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "kind": {
          "type": "string",
          "enum": ["up", "across", "diagonal", "reset", "fork"]
        },
        "reach": {
          "type": "string",
          "enum": ["adjacent", "stretch", "leap"]
        },
        "flags": {
          "type": "array",
          "minItems": 0,
          "maxItems": 3,
          "items": {
            "type": "string",
            "enum": ["outside_time", "below_pay_floor", "needs_relocation"]
          }
        },
        "about": {
          "type": "string",
          "enum": ["intake", "roads", "road", "job_today", "general"]
        },
        "worth_exploring": {
          "type": "boolean"
        },
        "kind_agree": {
          "type": "boolean"
        },
        "rating": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "text": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1500
        }
      }
    }
  },
  "$defs": {
    "intake": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "mode"],
      "properties": {

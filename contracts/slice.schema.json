{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/slice.schema.json",
  "title": "Occupation slice",
  "description": "One graph slice, data/graph/slices/<soc>.json (SPEC 5.4). Self-contained: the occupation, its top 40 needs, its tasks with AI use, its level, its signals, up to 30 road targets each with their own top 40 needs, and (S1 amendment A1) the skill_near pairs between the skills in those needs. Every fact points at an entry in sources (src) and carries its own as_of. The size limit (SPEC 5.3) is 60 KB gzipped per slice. This is the canonical slice schema; BUILD_PLAN and TEST_PLAN call it matcher/slice.schema.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["slice_v", "release", "occ", "needs", "tasks", "signals", "targets", "sources"],
  "properties": {
    "slice_v": {
      "type": "integer",
      "enum": [1]
    },
    "release": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "occ": {
      "$ref": "#/$defs/occupation"
    },
    "ladder": {
      "type": "array",
      "minItems": 0,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["level", "label"],
        "properties": {
          "level": {
            "type": "integer",
            "enum": [1, 2, 3, 4, 5, 6]
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "years": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10,
            "pattern": "^[0-9]+(-[0-9]+|\\+)$"
          }
        }
      }
    },
    "needs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "$ref": "#/$defs/need"
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 0,
      "maxItems": 80,
      "items": {
        "$ref": "#/$defs/task"
      }
    },
    "signals": {
      "type": "array",
      "minItems": 0,
      "maxItems": 40,
      "items": {
        "$ref": "#/$defs/signal"
      }
    },
    "targets": {
      "type": "array",
      "minItems": 0,
      "maxItems": 30,
      "items": {
        "$ref": "#/$defs/target"
      }
    },
    "near": {
      "$ref": "#/$defs/near"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "trust", "as_of"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "^[a-z0-9_]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^https://[A-Za-z0-9-]+(\\.[A-Za-z0-9-]+)+(:[0-9]{1,5})?(/[^\\s]*)?$"
        },
        "trust": {
          "type": "string",
          "enum": ["official", "secondary", "estimate", "observed"]
        },
        "as_of": {
          "type": "string",
          "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$"
        },
        "licence": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      }
    },
    "need": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "kind", "w", "ai", "as_of", "src"],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 80,
          "pattern": "^(skl|tec):[A-Za-z0-9]+([._-][A-Za-z0-9]+)*$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "kind": {
          "type": "string",
          "enum": ["skill", "knowledge", "activity", "technology"]
        },
        "w": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "ai": {
          "type": "string",
          "enum": ["ai_does_much", "mixed", "people_do", "unknown"]
        },
        "as_of": {
          "type": "string",
          "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$"
        },
        "src": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "ai_mode", "as_of", "src"],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 80,
          "pattern": "^tsk:[A-Za-z0-9]+([._-][A-Za-z0-9]+)*$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "ai_mode": {
          "type": "string",
          "enum": ["automation", "augmentation", "used", "none", "unknown"],
          "description": "automation or augmentation: AI use seen, with that split. used: AI use seen in the task data (penetration above 0) but the data has no automation/augmentation split. none: the task is in the AI data and no use was seen (penetration 0). unknown: the task is not in the AI data. (S1 amendment A1 added used.)"
        },
        "as_of": {
          "type": "string",
          "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$"
        },
        "src": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        }
      }
    },
    "signal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "period", "value", "as_of", "src"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["ai_obs", "ai_tier", "pay_band_in", "demand_trend", "skill_trend", "entry_share", "city_share", "remote_share", "pay_band_city"]
        },
        "period": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "value": {
          "type": ["string", "number"]
        },
        "as_of": {
          "type": "string",
          "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$"
        },
        "src": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        }
      }
    },
    "occupation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "job_zone", "as_of", "src"],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 80,
          "pattern": "^occ:([0-9]{2}-[0-9]{4}\\.[0-9]{2}|(ai|in)-[a-z0-9]+(-[a-z0-9]+)*)$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "alt": {
          "type": "array",
          "minItems": 0,
          "maxItems": 30,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "soc": {
          "type": "string",
          "pattern": "^[0-9]{2}-[0-9]{4}(\\.[0-9]{2})?$"
        },
        "isco": {
          "type": "array",
          "minItems": 0,
          "maxItems": 10,
          "items": {
            "type": "string",
            "pattern": "^[0-9]{4}$"
          }
        },
        "job_zone": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 5
        },
        "typical_level": {
          "type": ["array", "null"],
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "enum": [1, 2, 3, 4, 5, 6]
          }
        },
        "new_role": {
          "type": "boolean"
        },
        "maturity": {
          "type": "string",
          "enum": ["settling", "established"]
        },
        "ratings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["oldest", "newest"],
          "properties": {
            "oldest": {
              "type": "string",
              "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$"
            },
            "newest": {
              "type": "string",
              "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$"
            }
          }
        },
        "as_of": {
          "type": "string",
          "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$"
        },
        "src": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["occ", "via", "needs", "signals"],
      "properties": {
        "occ": {
          "$ref": "#/$defs/occupation"
        },
        "via": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "string",
            "enum": ["close_to", "two_step", "same_cluster", "entry_from"]
          }
        },
        "needs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 40,
          "items": {
            "$ref": "#/$defs/need"
          }
        },
        "signals": {
          "type": "array",
          "minItems": 0,
          "maxItems": 40,
          "items": {
            "$ref": "#/$defs/signal"
          }
        }
      }
    },
    "near": {
      "description": "skill_near (SPEC 5.2) for this slice, added by S1 amendment A1: each pair [a, b, similarity] once, a before b, both skills in the needs of the occupation or of a target. Similarity is read both ways. Only pairs of 0.5 or more are kept. The matcher reads this unless a caller passes its own near data.",
      "type": "object",
      "additionalProperties": false,
      "required": ["pairs", "as_of", "src", "trust"],
      "properties": {
        "pairs": {
          "type": "array",
          "minItems": 0,
          "maxItems": 2000,
          "items": {
            "$ref": "#/$defs/near_pair"
          }
        },
        "as_of": {
          "type": "string",
          "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$"
        },
        "src": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "trust": {
          "type": "string",
          "enum": ["official", "secondary", "estimate", "observed"]
        }
      }
    },
    "near_pair": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {
          "type": "string",
          "maxLength": 80,
          "pattern": "^skl:[A-Za-z0-9]+([._-][A-Za-z0-9]+)*$"
        },
        {
          "type": "string",
          "maxLength": 80,
          "pattern": "^skl:[A-Za-z0-9]+([._-][A-Za-z0-9]+)*$"
        },
        {
          "type": "number",
          "minimum": 0.5,
          "maximum": 1
        }
      ]
    }
  }
}

rs.","ai_mode":"none","as_of":"2026-10-22","src":"aei_task"},{"id":"tsk:14008","label":"Select cutting speeds, feed rates, and depths of cuts, applying knowledge of metal properties and shop mathematics.","ai_mode":"none","as_of":"2026-10-22","src":"aei_task"},{"id":"tsk:14009","label":"Move cutters or material manually or by turning handwheels, or engage automatic feeding mechanisms to mill workpieces to specifications.","ai_mode":"none","as_of":"2026-10-22","src":"aei_task"},{"id":"tsk:14010","label":"Replace worn tools, using hand tools, and sharpen dull tools, using bench grinders.","ai_mode":"none","as_of":"2026-10-22","src":"aei_task"},{"id":"tsk:14011","label":"Select and install cutting tools and other accessories according to specifications, using hand tools or power tools.","ai_mode":"none","as_of":"2026-10-22","src":"aei_task"},{"id":"tsk:14012","label":"Record production output.","ai_mode":"none","as_of":"2026-10-22","src":"aei_task"},{"id":"tsk:14013","label":"Turn valves or pull levers to start and regulate the flow of coolant or lubricant to work areas.","ai_mode":"none","as_of":"2026-10-22","src":"aei_task"},{"id":"tsk:14015","label":"Mount attachments and tools, such as pantographs, engravers, or routers, to perform other operations, such as drilling or boring.","ai_mode":"none","as_of":"2026-10-22","src":"aei_task"},{"id":"tsk:14014","label":"Make templates or cutting tools.","ai_mode":"none","as_of":"2026-10-22","src":"aei_task"}],"signals":[{"kind":"ai_obs","period":"latest","value":0.0,"as_of":"2026-10-22","src":"aei_obs"},{"kind":"ai_tier","period":"latest","value":"moderate","as_of":"2026-08","src":"bls_ai"}],"targets":[{"occ":{"id":"occ:51-4033.00","label":"Grinding, Lapping, Polishing, and Buffing Machine Tool Setters, Operators, and Tenders, Metal and Plastic","soc":"51-4033.00","job_zone":2,"ratings":{"newest":"2026-08","oldest":"2026-08"},"as_of":"2026-08","src":"onet"},"via":["close_to"],"needs":[{"id":"tec:autodesk-autocad","label":"Aut
f":"2025-08","src":"onet"},{"id":"skl:2.A.2.a","label":"Critical Thinking","kind":"skill","w":0.2716,"ai":"people_do","as_of":"2025-08","src":"onet"},{"id":"skl:4.A.4.b.4","label":"Guiding, Directing, and Motivating Subordinates","kind":"activity","w":0.255,"ai":"unknown","as_of":"2025-08","src":"onet"},{"id":"skl:2.A.2.d","label":"Monitoring","kind":"skill","w":0.2461,"ai":"people_do","as_of":"2025-08","src":"onet"}],"tasks":[{"id":"tsk:14797","label":"Confer with stage or motion picture officials and performers to determine desired effects.","ai_mode":"none","as_of":"2026-10-22","src":"aei_task"},{"id":"tsk:14798","label":"Duplicate work precisely to replicate characters' appearances on a daily basis.","ai_mode":"none","as_of":"2026-10-22","src":"aei_task"},{"id":"tsk:14799","label":"Establish budgets, and work within budgetary limits.","ai_mode":"none","as_of":"2026-10-22","src":"aei_task"},{"id":"tsk:14800","label":"Apply makeup to enhance or alter the appearance of people appearing in productions such as movies.","ai_mode":"none","as_of":"2026-10-22","src":"aei_task"},{"id":"tsk:14801","label":"Alter or maintain makeup during productions as necessary to compensate for lighting changes or to achieve continuity of effect.","ai_mode":"none","as_of":"2026-10-22","src":"aei_task"},{"id":"tsk:14802","label":"Select desired makeup shades from stock, or mix oil, grease, and coloring to achieve specific color effects.","ai_mode":"none","as_of":"2026-10-22","src":"aei_task"},{"id":"tsk:14803","label":"Cleanse and tone the skin to prepare it for makeup application.","ai_mode":"none","as_of":"2026-10-22","src":"aei_task"},{"id":"tsk:14804","label":"Assess performers' skin type to ensure that makeup will not cause break-outs or skin irritations.","ai_mode":"none","as_of":"2026-10-22","src":"aei_task"},{"id":"tsk:14805","label":"Analyze a script, noting events that affect each character's appearance, so that plans can be made for each scene.","ai_mode":"none","as_of":"2026-10-22","src":"aei_task"},{"id":"tsk:14806","label":"Requisition or acquire needed materials for special effects, including wigs, beards, and special cosmetics.","ai_mode":"none","as_of":"2026-10-22","src":"aei_task"},{"id":"tsk:14807","label":"Write makeup sheets and take photos to document specific looks and the products used to achieve the looks.","ai_mode":"none","as_of":"2026-10-22","src":"aei_task"},{"id":"tsk:14808","label":"Examine sketches, photographs, and plaster models to obtain desired character image depiction.","ai_mode":"none","as_of":"2026-10-22","src":"aei_task"},{"id":"tsk:14809","label":"Attach prostheses to performers and apply makeup to create special features or effects, such as scars, aging, or illness.","ai_mode":"none","as_of":"2026-10-22","src":"aei_task"},{"id":"tsk:14810","label":"Evaluate environmental characteristics, such as venue size and lighting plans, to determine makeup requirements.","ai_mode":"none","as_of":"2026-10-22","src":"aei_task"},{"id":"tsk:14811","label":"Design rubber or plastic prostheses that can be used to change performers' appearances.","ai_mode":"none","as_of":"2026-10-22","src":"aei_task"},{"id":"tsk:14812","label":"Create character drawings or models, based upon independent research, to augment period production files.","ai_mode":"none","as_of":"2026-10-22","src":"aei_task"},{"id":"tsk:14814","label":"Study production information, such as character descriptions, period settings, and situations, to determine makeup requirements.","ai_mode":"none","as_of":"2026-10-22","src":"aei_task"},{"id":"tsk:14815","label":"Provide performers with makeup removal assistance after performances have been completed.","ai_mode":"none","as_of":"2026-10-22","src":"aei_task"},{"id":"tsk:14817","label":"Demonstrate products to clients, and provide instruction in makeup application.","ai_mode":"none","as_of":"2026-10-22","src":"aei_task"},{"id":"tsk:24008","label":"Clean supplies such as makeup brushes.","ai_mode":"unknown","as_of":"2025-08","src":"onet"},{"id":"tsk:14813","label":"Advise hairdressers on the hairstyles required for character parts.","ai_mode":"none","as_of":"2026-10-22","src":"aei_task"},{"id":"tsk:14816","label":"Wash and reset wigs.","ai_mode":"none","as_of":"2026-10-22","src":"aei_task"}],"signals":[{"kind":"ai_obs","period":"latest","value":0.0,"as_of":"2026-10-22","src":"aei_obs"},{"kind":"ai_tier","period":"latest","value":"moderate","as_of":"2026-08","src":"bls_ai"}],"targets":[{"occ":{"id":"occ:39-5094.00","label":"Skincare Specialists","soc":"39-5094.00","job_zone":3,"ratings":{"newest":"2025-08","oldest":"2025-08"},"as_of":"2026-08","src":"onet"},"via":["close_to"],"needs":[{"id":"tec:microsoft-excel","label":"Microsoft Excel","kind":"technology","w":0.8,"ai":"unknown","as_of":"2026-08","src":"onet"},{"id":"tec:microsoft-office-software","label":"Microsoft Office software","kind":"technology","w":0.8,"ai":"unknown","as_of":"2026-08","src":"onet"},{"id":"tec:microsoft-powerpoint","label":"Microsoft PowerPoint","kind":"technology","w":0.8,"ai":"unknown","as_of":"2026-08","src":"onet"},{"id":"tec:microsoft-word","label":"Microsoft Word","kind":"technology","w":0.8,"ai":"unknown","as_of":"2026-08","src":"onet"},{"id":"skl:4.A.4.a.4","label":"Establishing and Maintaining Interpersonal Relationships","kind":"activity","w":0.678,"ai":"unknown","as_of":"2025-08","src":"onet"},{"id":"skl:2.C.1.e","label":"Customer and Personal Service","kind":"knowledge","w":0.6246,"ai":"unknown","as_of":"2025-08","src":"onet"},{"id":"skl:4.A.1.a.2","label":"Monitoring Processes, Materials, or Surroundings","kind":"activity","w":0.6046,"ai":"unknown","as_of":"2025-08","src":"onet"},{"id":"tec:spa-management-software","label":"Spa management software","kind":"technology","w":0.6,"ai":"unknown","as_of":"2026-08","src":"onet"},{"id":"skl:4.A.2.b.6","label":"Organizing, Planning, and Prioritizing Work","kind":"activity","w":0.5739,"ai":"unknown","as_of":"2025-08","src":"onet"},{"id":"skl:4.A.2.b.3",
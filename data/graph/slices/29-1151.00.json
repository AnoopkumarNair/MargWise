aei_task"},{"id":"tsk:18374","label":"Insert peripheral or central intravenous catheters.","ai_mode":"none","as_of":"2026-10-22","src":"aei_task"},{"id":"tsk:18375","label":"Instruct nurses, residents, interns, students, or other staff on topics such as anesthetic techniques, pain management and emergency responses.","ai_mode":"none","as_of":"2026-10-22","src":"aei_task"},{"id":"tsk:18376","label":"Read current literature, talk with colleagues, and participate in professional organizations or conferences to keep abreast of developments in nursing.","ai_mode":"none","as_of":"2026-10-22","src":"aei_task"},{"id":"tsk:18377","label":"Request anesthesia equipment repairs, adjustments, or safety tests.","ai_mode":"none","as_of":"2026-10-22","src":"aei_task"}],"signals":[{"kind":"ai_obs","period":"latest","value":0.0,"as_of":"2026-10-22","src":"aei_obs"},{"kind":"ai_tier","period":"latest","value":"low","as_of":"2026-08","src":"bls_ai"}],"targets":[{"occ":{"id":"occ:29-1211.00","label":"Anesthesiologists","soc":"29-1211.00","job_zone":5,"ratings":{"newest":"2026-08","oldest":"2026-08"},"as_of":"2026-08","src":"onet"},"via":["close_to"],"needs":[{"id":"skl:2.C.5.a","label":"Medicine and Dentistry","kind":"knowledge","w":0.9514,"ai":"unknown","as_of":"2026-08","src":"onet"},{"id":"skl:4.A.4.a.5","label":"Assisting and Caring for Others","kind":"activity","w":0.9512,"ai":"people_do","as_of":"2026-08","src":"onet"},{"id":"skl:4.A.1.a.2","label":"Monitoring Processes, Materials, or Surroundings","kind":"activity","w":0.843,"ai":"unknown","as_of":"2026-08","src":"onet"},{"id":"skl:4.A.2.b.1","label":"Making Decisions and Solving Problems","kind":"activity","w":0.8427,"ai":"unknown","as_of":"2026-08","src":"onet"},{"id":"skl:2.C.4.d","label":"Biology","kind":"knowledge","w":0.8082,"ai":"unknown","as_of":"2026-08","src":"onet"},{"id":"skl:2.C.4.e","label":"Psychology","kind":"knowledge","w":0.8039,"ai":"unknown","as_of":"2026-08","src":"onet"},{"id":"tec:epic-systems","label":"Epi